# Copy this file to .env and fill in real values. NEVER commit .env.
# Generate strong tokens with: openssl rand -hex 32

# MongoDB connection string
#   Local: mongodb://localhost:27017/leads
#   Atlas: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/leads
MONGODB_URI=mongodb://localhost:27017/leads

# Secret used to sign JWTs (openssl rand -hex 32)
JWT_SECRET=replace-with-random-64-hex-chars

# Login tokens. Each grants CRM access for that user (openssl rand -hex 32).
# Boss = main manager (full access). The rest are call managers.
BOSS_TOKEN=replace-with-random-64-hex-chars
CALL_ANVAR_TOKEN=replace-with-random-64-hex-chars
CALL_AKBAR_TOKEN=replace-with-random-64-hex-chars
CALL_DAVRON_TOKEN=replace-with-random-64-hex-chars

PORT=3000

# Optional: override CORS allow-list (comma-separated)
# CORS_ORIGIN=https://mvp-kokcha.netlify.app,https://api.kukcha-eshiklari.uz
