{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/doors.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/doors", "dest": "/api/doors.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/dashboard", "dest": "/public/admin.html" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/done_calls", "dest": "/public/done_calls.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
